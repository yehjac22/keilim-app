{
  "name": "keilim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "host": "npm run build && npm run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "android:build": "bash scripts/build-android-apk.sh",
    "bundle:windows": "npm run build && node scripts/prepare-windows-bundle.cjs",
    "build:exe": "npm run bundle:windows && npx pkg scripts/windows-server.cjs --targets node18-win-x64 --output dist/windows/keilim-server.exe"
  },
  "dependencies": {
    "next": "^15.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.18",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.4.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "pkg": "^5.8.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^2.1.9"
  }
}
