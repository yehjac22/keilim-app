{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/utensil/[id]",
      "regex": "^/utensil/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/utensil/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/android",
      "regex": "^/android(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/android(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/donate",
      "regex": "^/donate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/donate(?:/)?$"
    },
    {
      "page": "/halachos",
      "regex": "^/halachos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/halachos(?:/)?$"
    },
    {
      "page": "/lights",
      "regex": "^/lights(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/lights(?:/)?$"
    },
    {
      "page": "/materials",
      "regex": "^/materials(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/materials(?:/)?$"
    },
    {
      "page": "/procedure",
      "regex": "^/procedure(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/procedure(?:/)?$"
    },
    {
      "page": "/rules",
      "regex": "^/rules(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rules(?:/)?$"
    },
    {
      "page": "/tap-to-pay",
      "regex": "^/tap\\-to\\-pay(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tap\\-to\\-pay(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}